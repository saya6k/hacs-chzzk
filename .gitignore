# Whitelist .gitignore — default-deny. Ignore everything at the top level,
# then re-include only the paths that belong in the repo. New/untracked junk
# and the local dev `config/` are therefore never committed by accident.
/*

# Tracked directories
!/.github/
!/.devcontainer/
!/custom_components/
!/docs/
!/scripts/

# Tracked top-level files
!/.gitattributes
!/.gitignore
!/CHANGELOG.md
!/LICENSE
!/README.md
!/hacs.json
!/zensical.en.toml
!/zensical.ko.toml

# Agent scaffolding (AGENTS.md and its CLAUDE.md / GEMINI.md symlinks,
# .agents/, .claude/, .gemini) is local-only and deliberately not whitelisted
# above — it stays on each developer's machine, out of the published repo.

# Noise inside tracked directories
__pycache__/
*.py[cod]
.DS_Store
